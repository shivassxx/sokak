# Uploads must never execute code (Apache/XAMPP; Caddy config enforces the same).
Options -ExecCGI -Indexes
<FilesMatch "\.(php\d?|phtml|phar|pht|phps|cgi|pl|py|sh)$">
  Require all denied
</FilesMatch>
<IfModule mod_php.c>
  php_flag engine off
</IfModule>
<IfModule mod_php7.c>
  php_flag engine off
</IfModule>
