# copy to .env on the server
DOMAIN=okey.example.com
# optional: protects GET /stats?token=...
STATS_TOKEN=change-me
# admin panel (https://DOMAIN/admin): owner "shivass" password, applied at every start (min 8 chars)
# (empty: a one-time password is generated and printed once in `docker compose logs app`)
SOKAK_OWNER_PASSWORD=
# staff accounts file, keep it on the data volume
STAFF_FILE=/app/data/staff.json
# optional: TURN relay for voice chat behind strict NATs (see Docs/Deploy.md)
# VITE_TURN_URL=turn:turn.example.com:3478
# VITE_TURN_USER=sokak
# VITE_TURN_PASS=change-me
